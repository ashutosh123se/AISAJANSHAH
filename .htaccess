<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct existing files and directories (like /api/ and /assets/)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. SPA Fallback for client-side routing (/login, /student, /admin)
  RewriteRule ^ index.html [L]
</IfModule>


